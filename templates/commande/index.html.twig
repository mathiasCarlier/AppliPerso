{# templates/commande/index.html.twig #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/commande/styles.css') }}">
{% endblock %}

{% block body %}
    <div id="commande-page">
        <h1>Liste des Commandes</h1>

        {# Lien de déconnexion pour les utilisateurs connectés #}
        {% if app.user %}
            <div class="mb-3">
                <a href="{{ path('app_logout') }}" class="btn btn-secondary">Déconnexion</a>
            </div>
        {% endif %}

        {# Bouton de retour à l'accueil #}
        <a href="{{ path('accueil') }}" class="btn btn-primary mb-3">Retour</a>

        {# Tableau des commandes #}
        <table class="table table-bordered">
            <thead class="thead-light">
                <tr>
                    <th>Client</th>
                    <th>Numéro Commande</th>
                    <th>Produits</th>
                    <th>Heure</th>
                    <th>Prix Total</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody id="commandes-tbody">
                {# Trier les commandes par ID en ordre décroissant #}
                {% set commandes_sorted = commandes|sort((a, b) => b.id <=> a.id) %}
                {% for commande in commandes_sorted %}
                    <tr>
                        <td>{{ commande.Client.nom ?? 'N/A' }} {{ commande.Client.prenom ?? 'N/A' }}</td>
                        <td>{{ commande.numeroCommande }}</td>
                        <td>
                            {% for ligne in commande.ligneCommandes %}
                                {{ ligne.Produit.nom }}
                                {% if ligne.Taille and ligne.Taille.unite %}
                                    ({{ ligne.Taille.unite }})
                                {% endif %}
                                ({{ ligne.quantite }}x) <br>
                            {% else %}
                                Aucun produit
                            {% endfor %}
                        </td>
                        <td>{{ commande.heure|date('H:i') }}</td>
                        <td>{{ commande.prixTotal }}€</td>
                        <td>
                            <select class="form-control statut-select" data-commande-id="{{ commande.id }}">
                                {% for statut in statuts %}
                                    <option value="{{ statut.id }}" {{ commande.Statut.id == statut.id ? 'selected' : '' }}>
                                        {{ statut.libelle }}
                                    </option>
                                {% endfor %}
                            </select>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucune commande trouvée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Script pour l'actualisation automatique et la mise à jour du statut #}
    <script>
        if (document.getElementById('commande-page')) {
            // Fonction pour attacher les écouteurs d'événements aux listes déroulantes
            function attachStatutListeners() {
                document.querySelectorAll('.statut-select').forEach(select => {
                    select.addEventListener('change', async function () {
                        const commandeId = this.getAttribute('data-commande-id');
                        const statutId = this.value;

                        try {
                            const response = await fetch(`/commande/${commandeId}/update-statut`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: JSON.stringify({ statutId: statutId })
                            });
                            const data = await response.json();
                            if (data.success) {
                                console.log('Statut de la commande mis à jour avec succès');
                            } else {
                                console.error('Erreur lors de la mise à jour');
                            }
                        } catch (error) {
                            console.error('Erreur AJAX :', error);
                        }
                    });
                });
            }

            // Attacher les écouteurs d'événements au chargement initial de la page
            attachStatutListeners();

            // Fonction pour actualiser le tableau des commandes
            async function refreshCommandes() {
                try {
                    const response = await fetch("{{ path('commande') }}");
                    if (!response.ok) throw new Error('Erreur réseau: ' + response.status);
                    const text = await response.text();
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(text, 'text/html');
                    const newTableBody = doc.querySelector('#commandes-tbody').innerHTML;
                    document.querySelector('#commandes-tbody').innerHTML = newTableBody;

                    // Réattacher les écouteurs d'événements après l'actualisation
                    attachStatutListeners();
                } catch (error) {
                    console.error('Erreur lors de la récupération des commandes:', error);
                }
            }

            // Actualiser le tableau toutes les 15 secondes
            setInterval(refreshCommandes, 15000);
        }
    </script>
{% endblock %}