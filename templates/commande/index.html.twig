{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/commande/styles.css') }}">
{% endblock %}

{% block body %}
    <div id="commande-page">
        <h1>Liste des Commandes</h1>

        {% if app.user %}
            <div class="mb-3">
                <a href="{{ path('app_logout') }}" class="btn btn-secondary">Déconnexion</a>
            </div>
        {% endif %}

        <button id="refresh-commandes" class="btn btn-primary mb-3">
            <i class="bi bi-arrow-clockwise"></i> Rafraîchir
        </button><br><br>

        <a href="{{ path('commande_other') }}" class="btn btn-primary mb-3">Terminés</a>
        <a href="{{ path('report') }}" class="btn btn-primary mb-3">Récap</a>
        <a href="{{ path('accueil') }}" class="btn btn-primary mb-3">Retour</a><br><br>

        {# Filtrer les commandes du jour #}
        {% set today = "now"|date("Y-m-d") %}
        {% set commandes_today = commandes|filter(command => command.heure|date("Y-m-d") == today) %}
        {% set commandes_sorted = commandes_today %} 

        <div id="commandes-tbody" class="row">
            <!-- Colonne pour le statut 1 -->
            <div class="col-12 col-md-4">
                <h3>En Attente</h3>
                {% set commandesStatut1 = commandes_sorted|filter(c => c.Statut.id == 1) %}
                {% for commande in commandesStatut1 %}
                    {% set statut_class = 'statut-' ~ commande.Statut.id %}
                    <div data-commande-id="{{ commande.id }}" class="commande-card mb-3">
                        <div class="card h-100 commande-card {{ statut_class }}">
                            <div class="card-body">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        {{ commande.Client.nom ?? "N/A" }}
                                    </h5>
                                </div>
                                <p class="mb-2 text-muted">
                                    <i class="bi bi-clock"></i> {{ commande.heure|date('H:i') }}
                                </p>
                                <span class="badge bg-secondary">{{ commande.Statut.libelle }}</span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p>Aucune commande est en attente.</p>
                {% endfor %}
            </div>

            <!-- Colonne pour le statut 2 -->
            <div class="col-12 col-md-4">
                <h3>En préparation</h3>
                {% set commandesStatut2 = commandes_sorted|filter(c => c.Statut.id == 2) %}
                {% for commande in commandesStatut2 %}
                    {% set statut_class = 'statut-' ~ commande.Statut.id %}
                    <div data-commande-id="{{ commande.id }}" class="commande-card mb-3">
                        <div class="card h-100 commande-card {{ statut_class }}">
                            <div class="card-body">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        {{ commande.Client.nom ?? "N/A" }}
                                    </h5>
                                </div>
                                <p class="mb-2 text-muted">
                                    <i class="bi bi-clock"></i> {{ commande.heure|date('H:i') }}
                                </p>
                                <span class="badge bg-secondary">{{ commande.Statut.libelle }}</span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p>Aucune commande est en préparation.</p>
                {% endfor %}
            </div>

            <!-- Colonne pour le statut 3 -->
            <div class="col-12 col-md-4">
                <h3>À régler</h3>
                {% set commandesStatut3 = commandes_sorted|filter(c => c.Statut.id == 3) %}
                {% for commande in commandesStatut3 %}
                    {% set statut_class = 'statut-' ~ commande.Statut.id %}
                    <div data-commande-id="{{ commande.id }}" class="commande-card mb-3">
                        <div class="card h-100 commande-card {{ statut_class }}">
                            <div class="card-body">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        {{ commande.Client.nom ?? "N/A" }}
                                    </h5>
                                </div>
                                <p class="mb-2 text-muted">
                                    <i class="bi bi-clock"></i> {{ commande.heure|date('H:i') }}
                                </p>
                                <span class="badge bg-secondary">{{ commande.Statut.libelle }}</span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p>Aucune commande est à régler.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Markup du popup overlay #}
    <div id="custom-popup-overlay" class="popup-overlay" style="display: none;">
        <div id="custom-popup" class="custom-popup">
            <div class="popup-header">
                <h3>Informations client</h3>
                <span class="close-popup" style="cursor: pointer;">&times;</span>
            </div>
            <div class="popup-content" id="popup-content"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        console.log("Script chargé");

        let currentPopupCommandeId = null;
        let refreshInterval; // Variable pour stocker l'intervalle d'actualisation
        let isPopupOpen = false;

        function showPopup(content, statusClass) {
            const overlay = document.getElementById('custom-popup-overlay');
            const popup = overlay.querySelector('.custom-popup');
            
            // Reset all classes and apply base + status
            popup.className = `custom-popup ${statusClass || ''}`;
            
            document.getElementById('popup-content').innerHTML = content;
            overlay.style.display = 'flex';
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Vérifier que l'élément .close-popup existe bien
            const closeBtn = document.querySelector('.close-popup');
            if (closeBtn) {
                closeBtn.addEventListener('click', closePopup);
            }
            document.getElementById('custom-popup-overlay').addEventListener('click', (e) => {
                if (e.target === e.currentTarget) closePopup();
            });
            document.getElementById('commande-page').addEventListener('click', async (event) => {
                const card = event.target.closest('[data-commande-id]');
                if (card) {
                    const commandeId = card.dataset.commandeId;
                    await openCommandeModal(commandeId);
                }
            });

            // Démarrage de l'actualisation automatique
            refreshInterval = setInterval(refreshCommandes, 15000);
            
            // Actualisation immédiate au premier chargement
            refreshCommandes();

            const refreshButton = document.getElementById("refresh-commandes");

            refreshButton.addEventListener("click", function () {
                fetch("{{ path('commande') }}", { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then(response => response.text())
                    .then(html => {
                        // Extraire uniquement le contenu des commandes
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, "text/html");
                        const newContent = doc.querySelector("#commandes-tbody").innerHTML;

                        // Remplacer les commandes actuelles
                        document.querySelector("#commandes-tbody").innerHTML = newContent;
                    })
                    .catch(error => console.error("Erreur lors du rafraîchissement :", error));
            });
        });

        async function openCommandeModal(commandeId) {
            try {
                const url = "{{ path('commande_details', {'id': 'REPLACE_ID'}) }}".replace('REPLACE_ID', commandeId);
                const response = await fetch(url);
                if (!response.ok) throw new Error('Erreur lors du chargement des détails');

                const data = await response.json();
                const currentStatus = data.statut.id;

                // Mapping des statuts et leurs libellés correspondants
                const statusLabels = {
                    1: "Commande en attente",
                    2: "Commande en préparation",
                    3: "Commande à régler"
                };
                const currentStatusLabel = statusLabels[currentStatus] || "Inconnu";

                // Par défaut, pour les statuts de 1 à 4
                let firstButtonLabel = "Retour";
                let secondButtonLabel = "Suivant";
                let thirdButtonLabel = "Passer la commande annulé";
                let firstButtonStyle = "";
                let secondButtonStyle = "";

                // Masquer le bouton "Retour" si le statut est 1
                if (currentStatus == 1) {
                    firstButtonStyle = "display: none;";
                }

                

                const htmlContent = `
                    <div class="client-info">
                        <p><strong>${data.client.nom} ${data.client.prenom}</strong></p>
                        <p>Commande #${data.numeroCommande}</p>
                        <p>Heure: ${new Date(data.heure).toLocaleTimeString()}</p>
                        <p>Total: ${data.prixTotal.toFixed(2)}€</p>
                    </div>

                    <div class="produit-list">
                        <h4>Produits :</h4>
                        ${data.ligneCommandes.map(lc => `
                            <div class="produit-item">
                                ${lc.produit.nom} 
                                ${lc.taille && lc.taille.unite ? `- ${lc.taille.unite}` : ''} 
                                x ${lc.quantite}
                            </div>
                        `).join('')}
                    </div>

                    <div class="statut-container">
                        <label>Statut : ${currentStatusLabel}</label>
                        <div class="status-buttons" data-commande-id="${commandeId}">
                            <div class="top-buttons">
                                <button type="button" class="btn btn-primary statut-btn first-btn" style="${firstButtonStyle}">
                                    ${firstButtonLabel}
                                </button>
                                <button type="button" class="btn btn-primary statut-btn second-btn" style="${secondButtonStyle}">
                                    ${secondButtonLabel}
                                </button>
                            </div>
                            <div class="bottom-buttons">
                                <button type="button" class="btn btn-danger statut-btn third-btn">
                                    ${thirdButtonLabel}
                                </button>
                            </div>
                        </div>
                    </div>
                `;

                document.getElementById('popup-content').innerHTML = htmlContent;
                const statutClass = 'statut-' + currentStatus;
                document.getElementById('custom-popup').className = `custom-popup ${statutClass}-popup`;
                showPopup(htmlContent);
                currentPopupCommandeId = commandeId;

                // Bouton "Retour"
                const firstBtn = document.querySelector('.status-buttons .first-btn');
                if (firstBtn) {
                    firstBtn.addEventListener('click', function() {
                        if (currentStatus > 1) {
                            const newStatus = currentStatus - 1;
                            updateStatut(commandeId, newStatus);
                        }
                    });
                }

                // Bouton "Suivant"
                const secondBtn = document.querySelector('.status-buttons .second-btn');
                if (secondBtn) {
                    secondBtn.addEventListener('click', function() {
                        if (currentStatus < 5) {
                            const newStatus = currentStatus + 1;
                            updateStatut(commandeId, newStatus);
                        }
                    });
                }

                // Bouton Annulé / Passer la commande en attente
                const thirdBtn = document.querySelector('.status-buttons .third-btn');
                thirdBtn.addEventListener('click', function() {
                    if (currentStatus == 5) {
                        updateStatut(commandeId, 1);
                    } else {
                        updateStatut(commandeId, 5);
                    }
                });

            } catch (error) {
                console.error('Erreur:', error);
                showPopup('<p class="text-danger">Impossible de charger les informations.</p>');
            }
        }

        function closePopup() {
            isPopupOpen = false;
            setTimeout(() => {
                if (!isPopupOpen) {
                    refreshInterval = setInterval(refreshCommandes, 15000);
                }
            }, 1000);
            document.getElementById('custom-popup-overlay').style.display = 'none';
            currentPopupCommandeId = null;
        }

       function updateStatut(commandeId, statutId) {
            fetch("{{ path('update_statut', {'id': 'REPLACE_ID'}) }}".replace('REPLACE_ID', commandeId), {  
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ statutId: statutId })
            })
            .then(response => {
                if (!response.ok) throw new Error('Erreur de mise à jour');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    refreshCommandes(); 

                    // Si le statut est 4 ou 5, fermer la popup
                    if (statutId === 4 || statutId === 5) {
                        closePopup();
                    } else {
                        setTimeout(() => {
                            openCommandeModal(commandeId);
                        }, 200);
                    }
                }
            })
            .catch(error => console.error('Error:', error));
        }


        async function refreshCommandes() {
            try {
                const response = await fetch("{{ path('commande') }}");
                const newHTML = await response.text();
                
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = newHTML;
                
                const commandesContainer = tempDiv.querySelector('#commandes-tbody');
                const currentContainer = document.getElementById('commandes-tbody');
                
                if (commandesContainer.innerHTML !== currentContainer.innerHTML) {
                    currentContainer.innerHTML = commandesContainer.innerHTML;
                    console.log('Commandes actualisées');
                }
                
            } catch (error) {
                console.error('Erreur:', error);
            }
        }
    </script>
{% endblock %}
