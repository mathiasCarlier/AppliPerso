{# 
   Template de gestion des commandes
   Ce template affiche et gère la liste des commandes en cours
   Fonctionnalités :
   - Affichage des commandes par statut (En attente, En préparation, À régler)
   - Filtrage des commandes du jour
   - Popup détaillé pour chaque commande
   - Mise à jour en temps réel des statuts
#}

<title>{% block title %}Commandes{% endblock %}</title>

{% block stylesheets %}
    {# Styles spécifiques à la page des commandes #}
    <link rel="stylesheet" href="{{ asset('styles/commande/styles.css') }}">
{% endblock %}

{% block body %}
    {# Bouton de retour à l'accueil #}
    <a href="{{ path('accueil') }}" class="btn btn-primary mb-3">Accueil</a>

    <div id="commande-page">
        <h1>Liste des commandes</h1>

        {# Bouton pour voir les commandes terminées #}
        <a href="{{ path('commande_other') }}" class="btn btn-primary mb-3">Terminés</a>
        
        {# Filtrage des commandes du jour #}
        {% set today = "now"|date("Y-m-d") %}
        {% set commandes_today = commandes|filter(command => command.heure|date("Y-m-d") == today) %}
        {% set commandes_sorted = commandes_today %} 

        <div id="commandes-tbody" class="row">
            {# Section des commandes en attente (Statut 1) #}
            <div class="col-12 col-md-4">
                <h3>En attente</h3>
                {% set commandesStatut1 = commandes_sorted|filter(c => c.Statut.id == 1) %}
                {% for commande in commandesStatut1 %}
                    {% set statut_class = 'statut-' ~ commande.Statut.id %}
                    <div data-commande-id="{{ commande.id }}" class="commande-card mb-3">
                        <div class="card h-100 commande-card {{ statut_class }}">
                            <div class="card-body">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        {{ commande.Client.nom ?? "N/A" }}
                                    </h5>
                                </div>
                                <p class="mb-2 text-muted">
                                    <i class="bi bi-clock"></i> {{ commande.heure|date('H:i') }}
                                </p>
                            </div>
                        </div>
                    </div><br>
                {% else %}
                    <p>Aucune commande est en attente.</p>
                {% endfor %}
            </div>

            {# Section des commandes en préparation (Statut 2) #}
            <div class="col-12 col-md-4">
                <h3>En préparation</h3>
                {% set commandesStatut2 = commandes_sorted|filter(c => c.Statut.id == 2) %}
                {% for commande in commandesStatut2 %}
                    {% set statut_class = 'statut-' ~ commande.Statut.id %}
                    <div data-commande-id="{{ commande.id }}" class="commande-card mb-3">
                        <div class="card h-100 commande-card {{ statut_class }}">
                            <div class="card-body">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        {{ commande.Client.nom ?? "N/A" }}
                                    </h5>
                                </div>
                                <p class="mb-2 text-muted">
                                    <i class="bi bi-clock"></i> {{ commande.heure|date('H:i') }}
                                </p>
                            </div>
                        </div>
                    </div><br>
                {% else %}
                    <p>Aucune commande est en préparation.</p>
                {% endfor %}
            </div>

            {# Section des commandes à régler (Statut 3) #}
            <div class="col-12 col-md-4">
                <h3>À régler</h3>
                {% set commandesStatut3 = commandes_sorted|filter(c => c.Statut.id == 3) %}
                {% for commande in commandesStatut3 %}
                    {% set statut_class = 'statut-' ~ commande.Statut.id %}
                    <div data-commande-id="{{ commande.id }}" class="commande-card mb-3">
                        <div class="card h-100 commande-card {{ statut_class }}">
                            <div class="card-body">
                                <div class="card-header">
                                    <h5 class="card-title">
                                        {{ commande.Client.nom ?? "N/A" }}
                                    </h5>
                                </div>
                                <p class="mb-2 text-muted">
                                    <i class="bi bi-clock"></i> {{ commande.heure|date('H:i') }}
                                </p>
                            </div>
                        </div>
                    </div><br>
                {% else %}
                    <p>Aucune commande est à régler.</p>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Popup pour afficher les détails d'une commande #}
    <div id="custom-popup-overlay" class="popup-overlay" style="display: none;">
        <div id="custom-popup" class="custom-popup">
            <div class="popup-header">
                <h3>Informations client</h3>
                <span class="close-popup" style="cursor: pointer;">&times;</span>
            </div>
            <div class="popup-content" id="popup-content"></div>
        </div>
    </div>

    {# Scripts JavaScript pour la gestion dynamique des commandes #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Initialisation des variables globales
        let currentPopupCommandeId = null;
        let refreshInterval; // Intervalle d'actualisation
        let isPopupOpen = false;

        /**
         * Affiche le popup avec le contenu spécifié
         * @param {string} content - Le contenu HTML à afficher
         * @param {string} statusClass - La classe CSS pour le style du statut
         */
        function showPopup(content, statusClass) {
            const overlay = document.getElementById('custom-popup-overlay');
            const popup = overlay.querySelector('.custom-popup');
            popup.className = `custom-popup ${statusClass || ''}`;
            document.getElementById('popup-content').innerHTML = content;
            overlay.style.display = 'flex';
        }

        // Initialisation des événements au chargement de la page
        document.addEventListener('DOMContentLoaded', () => {
            // Configuration des gestionnaires d'événements
            const closeBtn = document.querySelector('.close-popup');
            if (closeBtn) {
                closeBtn.addEventListener('click', closePopup);
            }

            // Fermeture du popup en cliquant sur l'overlay
            document.getElementById('custom-popup-overlay').addEventListener('click', (e) => {
                if (e.target === e.currentTarget) closePopup();
            });

            // Gestion des clics sur les cartes de commande
            document.getElementById('commande-page').addEventListener('click', async (event) => {
                const card = event.target.closest('[data-commande-id]');
                if (card) {
                    const commandeId = card.dataset.commandeId;
                    await openCommandeModal(commandeId);
                }
            });

            // Configuration de l'actualisation automatique
            refreshInterval = setInterval(refreshCommandes, 15000);
            refreshCommandes(); // Première actualisation immédiate
        });

        /**
         * Ouvre le modal des détails d'une commande
         * @param {string} commandeId - L'identifiant de la commande
         */
        async function openCommandeModal(commandeId) {
            try {
                // Récupération des détails de la commande
                const url = "{{ path('commande_details', {'id': 'REPLACE_ID'}) }}".replace('REPLACE_ID', commandeId);
                const response = await fetch(url);
                if (!response.ok) throw new Error('Erreur lors du chargement des détails');

                const data = await response.json();
                const currentStatus = data.statut.id;

                // Configuration des libellés de statut
                const statusLabels = {
                    1: "Commande en attente",
                    2: "Commande en préparation",
                    3: "Commande à régler",
                    4: "Commande terminée",
                    5: "Commande annulée"
                };
                const currentStatusLabel = statusLabels[currentStatus] || "Inconnu";

                // Construction du contenu HTML du popup
                const htmlContent = `
                    <div class="client-info">
                        <p><strong>${data.client.nom} ${data.client.prenom} / ${new Date(data.heure).toLocaleTimeString()}</strong></p>
                        <p><strong>Commande #${data.numeroCommande}</strong></p>
                        <div class="total-annule-container">
                            <p><strong>Total: ${data.prixTotal.toFixed(2)}€</strong></p>
                            <button type="button" class="btn btn-danger statut-btn annul-btn">
                                Annuler
                            </button>
                        </div>
                    </div>

                    <div class="produit-list">
                        <h3>Commande à préparer :</h3>
                        ${data.ligneCommandes.map(lc => `
                            <div class="produit-item">
                                ${lc.produit.nom} : ${lc.quantite}
                                ${lc.taille && lc.taille.unite ? `- ${lc.taille.unite}` : ''} 
                            </div>
                        `).join('')}
                        <p>Nombre de produits: ${data.nombreTotalProduits}</p>
                    </div>

                    <div class="statut-container">
                        <label class="statut-label">STATUT COMMANDE</label>
                        <div class="status-buttons" data-commande-id="${commandeId}">
                            <button type="button" class="btn btn-primary statut-btn" id="btnPreparation">
                                En préparation
                            </button>
                            <button type="button" class="btn btn-primary statut-btn" id="btnRegler">
                                À régler
                            </button>
                            <button type="button" class="btn btn-primary statut-btn" id="btnTermine">
                                Terminé
                            </button>
                        </div>
                    </div>
                `;

                // Affichage et configuration du popup
                showPopup(htmlContent);
                currentPopupCommandeId = commandeId;

                // Mise à jour des classes de statut actif
                document.querySelectorAll('.statut-btn').forEach(btn => btn.classList.remove('statut-active'));
                const statutClass = 'statut-' + currentStatus;
                document.getElementById('custom-popup').className = `custom-popup ${statutClass}-popup`;

                // Configuration des boutons de statut
                if (currentStatus === 2) {
                    document.getElementById('btnPreparation').classList.add('statut-active');
                } else if (currentStatus === 3) {
                    document.getElementById('btnRegler').classList.add('statut-active');
                } else if (currentStatus === 4) {
                    document.getElementById('btnTermine').classList.add('statut-active');
                } else if (currentStatus === 5) {
                    document.querySelector('.annul-btn').classList.add('statut-active');
                }

                // Configuration des gestionnaires d'événements pour les changements de statut
                document.getElementById('btnPreparation').addEventListener('click', () => updateStatut(commandeId, 2));
                document.getElementById('btnRegler').addEventListener('click', () => updateStatut(commandeId, 3));
                document.getElementById('btnTermine').addEventListener('click', () => updateStatut(commandeId, 4));
                document.querySelector('.annul-btn').addEventListener('click', () => updateStatut(commandeId, 5));

            } catch (error) {
                console.error('Erreur:', error);
                alert('Une erreur est survenue lors du chargement des détails de la commande');
            }
        }

        function closePopup() {
            isPopupOpen = false;
            setTimeout(() => {
                if (!isPopupOpen) {
                    refreshInterval = setInterval(refreshCommandes, 15000);
                }
            }, 1000);
            document.getElementById('custom-popup-overlay').style.display = 'none';
            currentPopupCommandeId = null;
        }

        function updateStatut(commandeId, statutId) {
            // Validation des paramètres
            if (!commandeId || !statutId) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: 'Paramètres invalides pour la mise à jour du statut'
                });
                return;
            }

            // Validation du statut
            const validStatuts = [1, 2, 3, 4, 5];
            if (!validStatuts.includes(statutId)) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: 'Statut invalide'
                });
                return;
            }

            // Token CSRF
            const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

            fetch("{{ path('update_statut', {'id': 'REPLACE_ID'}) }}".replace('REPLACE_ID', commandeId), {  
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-TOKEN': token
                },
                body: JSON.stringify({ statutId: statutId })
            })
            .then(response => {
                if (!response.ok) {
                    if (response.status === 403) {
                        throw new Error('Accès non autorisé');
                    } else if (response.status === 404) {
                        throw new Error('Commande non trouvée');
                    } else {
                        throw new Error('Erreur serveur');
                    }
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Succès',
                        text: 'Statut mis à jour avec succès',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    refreshCommandes(); 

                    if (statutId === 4 || statutId === 5) {
                        closePopup();
                    } else {
                        setTimeout(() => {
                            openCommandeModal(commandeId);
                        }, 200);
                    }
                } else {
                    throw new Error(data.message || 'Erreur lors de la mise à jour');
                }
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: error.message || 'Une erreur est survenue lors de la mise à jour du statut'
                });
                console.error('Error:', error);
            });
        }

        async function refreshCommandes() {
            try {
                const response = await fetch("{{ path('commande') }}");
                const newHTML = await response.text();
                
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = newHTML;
                
                const commandesContainer = tempDiv.querySelector('#commandes-tbody');
                const currentContainer = document.getElementById('commandes-tbody');
                
                if (commandesContainer.innerHTML !== currentContainer.innerHTML) {
                    currentContainer.innerHTML = commandesContainer.innerHTML;
                    console.log('Commandes actualisées');
                }
                
            } catch (error) {
                console.error('Erreur:', error);
            }
        }
    </script>
{% endblock %}
