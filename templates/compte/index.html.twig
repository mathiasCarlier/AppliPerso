{% extends 'base.html.twig' %}

{% block title %}Modifier vos informations{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/compte/styles.css') }}">
{% endblock %}

{% block body %}
    
    {#{% if app.user %}
        <div class="mb-3">
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        </div>
    {% endif %}#}

    <div class="example-wrapper">
        <h1>{{ message }}</h1>

        {{ form_start(form) }}
            <div class="form-row">
                {{ form_row(form.nom, { label: 'Nom :' }) }}
            </div>
            <div class="form-row">
                {{ form_row(form.prenom, { label: 'Prénom :' }) }}
            </div>
            <div class="form-row">
                {{ form_row(form.login, { label: 'Login :' }) }}
            </div>
            <div class="form-row">
                {{ form_row(form.mdp, { label: 'Mot de passe :' }) }}
            </div>
            <div class="form-row">
                {{ form_row(form.confirm_mdp, { label: 'Confirmer le mot de passe :' }) }}
            </div>
            <div class="form-row">
                {{ form_row(form.mail, { label: 'Mail :' }) }}
            </div>
            <div class="form-row">
                {{ form_row(form.telephone, { label: 'Téléphone :' }) }}
            </div>

            <button type="submit" class="btn btn-primary">Enregistrer</button>
        {{ form_end(form) }}
        
        <a href="{{ path('accueil') }}" class="btn btn-secondary">Retour</a>
    </div>
{% endblock %}