<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription</title>
    <link rel="stylesheet" href="{{ asset('styles/inscription/styles.css') }}">
</head>
<body>
      
    <div class="example-wrapper">

    <h1>{{ message }}</h1>

        {{ form_start(form) }}

            <div class="form-row">
                {{ form_row(form.nom, {label: 'Nom :'}) }}
            </div>
            <div class="form-row">
                {{ form_row(form.prenom, {label: 'Prénom :'}) }}
            </div>
            <div class="form-row">
                {{ form_row(form.login, {label: 'Login :'}) }}
            </div>
            <div class="form-row">
                {{ form_row(form.mdp, {label: 'Mot de passe :'}) }}
            </div>
            <div class="form-row">
                {{ form_row(form.mail, {label: 'Mail :'}) }}
            </div>
            <div class="form-row">
                {{ form_row(form.telephone, {label: 'Téléphone :'}) }}
            </div>
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary">Envoyer</button>
        {{ form_end(form) }}
        <a href="{{ path('app_login') }}" class="btn btn-secondary">Retour</a>
    </div>
    
</body>
</html>
