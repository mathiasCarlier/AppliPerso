<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil</title>
</head>
<body>

    <h1> {{message}} </h1>
    
    <div class="example-wrapper">
        
        {{ form_start(form) }}
            {{ form_row(form.nom, {label: 'Nom :'}) }}
            {{ form_row(form.prenom, {label: 'Prenom :'}) }}
            {{ form_row(form.login, {label: 'Login :'}) }}
            {{ form_row(form.mdp, {label: 'Mot de passe :'}) }}
            {{ form_row(form.mail, {label: 'Mail :'}) }}
            {{ form_row(form.telephone, {label: 'Téléphone :'}) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-primary">Envoyer</button>
        {{ form_end(form) }}
    </div>
</body>
</html>

