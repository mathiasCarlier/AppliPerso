{# 
   Template de rapport des ventes de produits
   Ce template affiche les statistiques de vente avec :
   - Filtrage par période (jour, semaine, mois, semestre)
   - Liste détaillée des produits vendus
   - Quantités et montants par produit
   - Total global des ventes
#}

<title>{% block title %}Produits{% endblock %}</title>

{% block stylesheets %}
    {# Styles spécifiques à la page de rapport #}
    <link rel="stylesheet" href="{{ asset('styles/report/styles.css') }}">
{% endblock %}

<body>
    {# Bouton de retour à la liste des commandes #}
    <a href="{{ path('commande_other') }}" class="btn btn-primary mb-3">Retour</a><br><br>
    
    <h1>Liste des produits commandés</h1>
    
    {# Sélecteur de période avec mise à jour automatique #}
    <form method="get" action="{{ path('report') }}">
        <label for="periode">Filtrer par période :</label>
        <select name="periode" id="periode" onchange="this.form.submit()">
            <option value="today" {% if periode == 'today' %}selected{% endif %}>Aujourd'hui</option>
            <option value="week" {% if periode == 'week' %}selected{% endif %}>Cette semaine</option>
            <option value="month" {% if periode == 'month' %}selected{% endif %}>Ce mois-ci</option>
            <option value="year" {% if periode == 'year' %}selected{% endif %}>6 derniers mois</option>
        </select>
    </form>
    
    {# Tableau des statistiques de vente #}
    <table>
        <thead>
            <tr>
                <th>Nom du produit</th>
                <th>Taille</th>
                <th>Quantité commandée</th>
                <th>Prix total</th>
            </tr>
        </thead>
        <tbody>
            {# Liste des produits avec leurs statistiques #}
            {% for product in products %}
                <tr>
                    <td>{{ product.productName }}</td>
                    <td>{{ product.taille }}</td>
                    <td>{{ product.totalQuantity }}</td>
                    {# Formatage du prix avec séparateurs de milliers et décimales #}
                    <td>{{ product.totalPrice | number_format(2, ',', ' ') }} €</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucun produit commandé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Affichage du chiffre d'affaires total #}
    <h2>Total global: {{ globalTotal | number_format(2, ',', ' ') }} €</h2>
</body>
