

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/accueil/styles.css') }}">
{% endblock %}

{% block body %}
    <!-- Bouton de déconnexion en haut à droite -->
    {% if app.user %}
        <div class="logout-container">
            <a href="{{ path('app_logout') }}" class="logout-link">Déconnexion</a>
        </div>
    {% endif %}

    <!-- Card pour les boutons de navigation -->
    <div class="card">
        {% if app.user %}
            <div class="welcome-message">
                Bienvenue <strong>{{ app.user.userIdentifier }}</strong>
            </div>
        {% endif %}

        {% if app.user.role %}
            {% set roleId = app.user.role.id %}
        {% else %}
            {% set roleId = null %}
        {% endif %}

        {% if roleId == 1 %}
            <!-- Tous les boutons -->
            <a href="{{ path('responsable') }}" class="btn">Liste du personnel</a>
            <a href="{{ path('commande') }}" class="btn">Liste des commandes</a>
            <a href="{{ path('produit') }}" class="btn">Liste des produits</a>
            <a href="{{ path('compte') }}" class="btn">Mon compte</a>
        {% elseif roleId == 2 %}
            <!-- Tous les boutons sauf celui de responsable -->
            <a href="{{ path('commande') }}" class="btn">Liste des commandes</a>
            <a href="{{ path('produit') }}" class="btn">Liste des produits</a>
            <a href="{{ path('compte') }}" class="btn">Mon compte</a>
        {% else %}
            <!-- Aucun bouton sauf déconnexion -->
            <div class="message-attente">
                <p>Vous devez attendre que l'admin vous vérifie.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
