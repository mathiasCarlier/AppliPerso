{% if app.user %}
            <div class="mb-3">
                <a href="{{ path('app_logout') }}">Déconnexion</a>
            </div>
{% endif %}
{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background:rgb(10, 6, 6); padding: 2px 6px; }
    </style>
    <div class="example-wrapper">
        {% if donnee is not null %}
        <div class="card mb-1 m-auto">
            <div class="card-body">
                <div class="card-title d-flex justify-content-between">
                    <h4 class="mb-1">{{ donnee.nom }}</h4>
                    <small class="text-muted">Prenom : {{ donnee.prenom }}</small><br>
                    <small class="text-muted">Identifiant : {{ donnee.id }}</small><br>
                    <small class="text-muted">Login : {{ donnee.login }}</small><br>
                    <small class="text-muted">Mail : {{ donnee.mail }}</small><br>
                    <small class="text-muted">Téléphone : {{ donnee.telephone }}</small><br>
            </div>
        </div>
    {% else %}
        <div>Auteur non trouvé</div>
    {% endif %}
    <a href="{{ path('responsable') }}" class="btn btn-primary">Retour</a>
    </div>
{% endblock %}