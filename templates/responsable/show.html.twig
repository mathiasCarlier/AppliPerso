{% extends 'base.html.twig' %}

{% block title %}Détail de {{ donnee.nom }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/responsable_show/styles.css') }}">
{% endblock %}

{% block body %}
    {% if app.user %}
        {% set roleId = app.user.role.id %}
    {% else %}
        {% set roleId = null %}
    {% endif %}

    {% if roleId == 1 %}
        <div class="example-wrapper cinema-theme">
            {% if donnee is not null %}
                <div class="cinema-card">
                    <div class="card-header">
                        <h2 class="movie-title">{{ donnee.nom }}</h2>
                        <div class="film-stripe"></div>
                    </div>
                    
                    <div class="card-content">
                        <div class="detail-item">
                            <span class="detail-label">Prénom :</span>
                            <span class="detail-value">{{ donnee.prenom }}</span>
                        </div>
                        
                        <div class="detail-grid">
                            <div class="detail-item">
                                <span class="detail-label">Identifiant :</span>
                                <span class="detail-value">{{ donnee.id }}</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Login :</span>
                                <span class="detail-value">{{ donnee.login }}</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Email :</span>
                                <span class="detail-value">{{ donnee.mail }}</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Téléphone :</span>
                                <span class="detail-value">{{ donnee.telephone }}</span>
                            </div>
                        </div>

                        <div class="access-control">
                            <label class="switch-label">Accès autorisé :</label>
                            <select class="cinema-select verif-responsable-select" data-id="{{ donnee.id }}">
                                <option value="1" {{ donnee.verifResponsable ? 'selected' : '' }}>✅ Oui</option>
                                <option value="0" {{ not donnee.verifResponsable ? 'selected' : '' }}>❌ Non</option>
                            </select>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="error-message">🎬 Auteur non trouvé</div>
            {% endif %}

            <a href="{{ path('responsable') }}" class="cinema-btn">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    {% else %}
        <script>
            window.location.href = "{{ path('accueil') }}";
        </script>
    {% endif %}

    <style>
        body {
            background: linear-gradient(45deg, #1a1a1a, #2a1e1e);
            min-height: 100vh;
            padding: 2rem;
        }
    </style>

    <script>
        document.querySelectorAll('.verif-responsable-select').forEach(select => {
            select.addEventListener('change', function() {
                const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
                const responsableId = this.dataset.id;
                const newValue = this.value;

                fetch(`/responsable/${responsableId}/verif/${newValue}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    }
                })
                .then(response => {
                    if (response.ok) {
                        const icon = newValue === '1' ? '✅' : '❌';
                        this.querySelector(`option[value="${newValue}"]`).innerHTML = `${icon} ${newValue === '1' ? 'Oui' : 'Non'}`;
                    }
                    if (response.status === 403) {
                        alert('Session expirée, veuillez rafraîchir la page');
                    }
                })
                .catch(error => console.error('Erreur réseau', error));
            });
        });
    </script>
{% endblock %}
