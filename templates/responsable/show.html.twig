{% extends 'base.html.twig' %}

{% block title %}Détail de {{ donnee.nom }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/responsable_show/styles.css') }}">
{% endblock %}

{% block body %}
    {% if app.user %}
        {% set roleId = app.user.role.id %}
    {% else %}
        {% set roleId = null %}
    {% endif %}

    {% if roleId == 1 %}
        <div class="example-wrapper cinema-theme">
            {% if donnee is not null %}
                <div class="cinema-card">
                    <div class="card-header">
                        <h2 class="movie-title">{{ donnee.nom }}</h2>
                        <div class="film-stripe"></div>
                    </div>
                    
                    <div class="card-content">
                        <div class="detail-item">
                            <span class="detail-label">Prénom :</span>
                            <span class="detail-value">{{ donnee.prenom }}</span>
                        </div>
                        
                        <div class="detail-grid">
                            <div class="detail-item">
                                <span class="detail-label">Identifiant :</span>
                                <span class="detail-value">{{ donnee.id }}</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Login :</span>
                                <span class="detail-value">{{ donnee.login }}</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Email :</span>
                                <span class="detail-value">{{ donnee.mail }}</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Téléphone :</span>
                                <span class="detail-value">{{ donnee.telephone }}</span>
                            </div>
                        </div>

                        <div class="access-control">
                            <label class="switch-label">Accès autorisé :</label>
                            <div>
                                Responsable <input type="radio" name="verif_responsable" value="2" data-id="{{ donnee.id }}" {% if donnee.role and donnee.role.id == 2 %}checked{% endif %}>
                                Admin <input type="radio" name="verif_responsable" value="1" data-id="{{ donnee.id }}" {% if donnee.role and donnee.role.id == 1 %}checked{% endif %}> 
                                Aucun <input type="radio" name="verif_responsable" value="0" data-id="{{ donnee.id }}" {% if not donnee.role %}checked{% endif %}> 
                            </div>
                        </div>
                    </div>
                </div>

                <div class="delete-button" id="delete-button" {% if donnee.role and donnee.role.id == 1 %} style="display: none;" {% endif %}>
                    <form id="delete-form" action="{{ path('responsable_delete', {'id': donnee.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ donnee.id) }}">
                        <button type="submit" class="cinema-btn delete-btn" id="delete-btn">Supprimer le responsable</button>
                    </form>
                </div>


            {% else %}
                <div class="error-message">🎬 Responsable non trouvé</div>
            {% endif %}

            <a href="{{ path('responsable') }}" class="cinema-btn">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    {% else %}
        <script>
            window.location.href = "{{ path('accueil') }}";
        </script>
    {% endif %}

   <script>
        document.querySelectorAll('input[name="verif_responsable"]').forEach(radio => {
           radio.addEventListener('change', function() {
                const responsableId = this.dataset.id;
                const newValue = this.value;
                const deleteButton = document.getElementById('delete-button');

                // Afficher ou masquer le bouton en fonction du rôle sélectionné
                if (newValue === "1") {
                    deleteButton.style.display = "none"; // Masquer si Admin
                } else {
                    deleteButton.style.display = "block"; // Afficher sinon
                }

                // Envoi de la mise à jour au serveur
                const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

                fetch(`/responsable/${responsableId}/verif/${newValue}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.status !== 'success') {
                        alert('Une erreur est survenue');
                    }
                })
                .catch(error => console.error('Erreur réseau', error));
            });
        });

        document.getElementById('delete-btn').addEventListener('click', function(event) {
            event.preventDefault(); // Empêche la soumission immédiate du formulaire

            const responsableNom = "{{ donnee.nom|e('js') }}";
            const responsablePrenom = "{{ donnee.prenom|e('js') }}";

            Swal.fire({
                title: "Confirmation",
                text: `Êtes-vous sûr de vouloir supprimer ${responsableNom} ${responsablePrenom} ?`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Oui, supprimer",
                cancelButtonText: "Annuler"
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('delete-form').submit(); // Soumet le formulaire si confirmé
                }
            });
        });

    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


{% endblock %}

