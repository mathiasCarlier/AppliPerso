{# 
   Template de gestion des produits
   Ce template affiche et gère la liste des produits du cinéma
   Fonctionnalités :
   - Affichage des produits dans un tableau
   - Filtrage par catégorie
   - Tri par différents critères
   - Gestion des prix par taille
   - Activation/désactivation des produits
   - Suppression des produits
#}

{% block stylesheets %}
    {# Styles spécifiques à la page des produits #}
    <link rel="stylesheet" href="{{ asset('styles/produit/styles.css') }}">
{% endblock %}

<title>{% block title %}Liste des Produits{% endblock %}</title>

{% block body %}
    {# Bouton de retour à l'accueil #}
    <a href="{{ path('accueil') }}" class="btn btn-primary mb-3">Accueil</a><br><br>
    
    <div id="produit-page">
        <h1>Liste des Produits</h1>

        {# Bouton d'ajout d'un nouveau produit #}
        <a href="{{ path('produit_new') }}" class="btn btn-primary">Ajouter un produit</a><br><br>

        {# Filtres et options de tri #}
        <div class="col-12 col-md-4 mb-2">
            <label for="categorie-select" class="form-label">Filtrer par catégorie :</label>
            <select id="categorie-select" class="form-select" onchange="filtrerParCategorie()">
                <option value="">Toutes les catégories</option>
                {% for categorie in categories %}
                    <option value="{{ categorie.id }}" {{ app.request.query.get('categorie') == categorie.id ? 'selected' : '' }}>
                        {{ categorie.libelle }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="col-12 col-md-4 mb-2">
            <label for="sortSelect" class="form-label">Trier par :</label>
            <select id="sortSelect" class="form-select" onchange="triCategorie()">
                <option value="category" selected>Catégorie</option>
                <option value="price_asc">Prix croissant</option>
                <option value="price_desc">Prix décroissant</option>
                <option value="name_asc">Nom A-Z</option>
                <option value="name_desc">Nom Z-A</option>
            </select>
        </div><br>

        {# Tableau des produits #}
        <table class="table table-bordered">
            <thead class="thead-light">
                <tr>
                    <th>Nom</th>
                    <th>Taille</th>
                    <th>Prix</th>
                    <th></th>
                    <th>Catégorie</th>
                    <th>Sous-Catégorie</th>
                    <th>En Ligne</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for produit in produits %}
                    <tr>
                        <td>{{ produit.nom }}</td>
                        {# Liste des tailles disponibles #}
                        <td>
                            <ul class="list-unstyled">
                                {% for avoir in produit.avoirs %}
                                    <li>{{ avoir.Taille.unite }}</li>
                                {% else %}
                                    <li>Aucune taille disponible</li>
                                {% endfor %}
                            </ul>
                        </td>
                        {# Prix par taille avec système d'édition #}
                        <td>
                            <ul class="list-unstyled d-flex flex-wrap gap-2">
                                {% for avoir in produit.avoirs %}
                                    <li>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span id="prix-{{ avoir.id }}">{{ avoir.prix }} €</span>
                                            <input type="number" 
                                                id="input-prix-{{ avoir.id }}" 
                                                value="{{ avoir.prix }}" 
                                                class="form-control d-none" 
                                                step="0.01">
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                        {# Boutons d'édition des prix #}
                        <td>
                            <ul class="list-unstyled d-flex flex-wrap gap-2">
                                {% for avoir in produit.avoirs %}
                                    <li>
                                        <div>
                                            <button class="btn btn-sm btn-warning" 
                                                    id="toggle-btn-{{ avoir.id }}" 
                                                    onclick="toggleEdit({{ avoir.id }})">
                                                ✏️
                                            </button>
                                            <button class="btn btn-sm btn-success d-none" 
                                                    id="save-btn-{{ avoir.id }}" 
                                                    onclick="savePrix({{ avoir.id }})">
                                                ✔
                                            </button>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                        <td>{{ produit.Categorie ? produit.Categorie.libelle : 'N/A' }}</td>
                        <td>{{ produit.sousCategorie ? produit.sousCategorie.libelle : 'N/A' }}</td>
                        {# Sélecteur pour activer/désactiver le produit #}
                        <td>
                            <select class="form-select en-ligne-select" data-id="{{ produit.id }}">
                                <option value="1" {{ produit.enLigne ? 'selected' : '' }}>Oui</option>
                                <option value="0" {{ not produit.enLigne ? 'selected' : '' }}>Non</option>
                            </select>
                        </td>
                        {# Bouton de suppression avec confirmation #}
                        <td>
                            <button type="button" class="btn btn-danger" onclick="confirmDelete('{{ produit.id }}', '{{ produit.nom|e('js') }}')">Supprimer</button>
                            <form id="delete-form-{{ produit.id }}" action="{{ path('produit_delete', {'id': produit.id}) }}" method="post" style="display: none;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                <button type="submit"></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun produit trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Scripts pour la gestion des interactions #}
    <script>
        /**
         * Bascule entre l'affichage et l'édition du prix
         * @param {number} avoirId - ID de la relation produit-taille
         */
        function toggleEdit(avoirId) {
            const elements = {
                prix: document.getElementById(`prix-${avoirId}`),
                input: document.getElementById(`input-prix-${avoirId}`),
                toggleBtn: document.getElementById(`toggle-btn-${avoirId}`),
                saveBtn: document.getElementById(`save-btn-${avoirId}`)
            };

            Object.values(elements).forEach(el => {
                if (el) el.classList.toggle('d-none');
            });

            if (!elements.input.classList.contains('d-none')) {
                elements.input.focus();
            }
        }

        /**
         * Sauvegarde le nouveau prix d'un produit
         * @param {number} avoirId - ID de la relation produit-taille
         */
        async function savePrix(avoirId) {
            const input = document.getElementById(`input-prix-${avoirId}`);
            const prix = parseFloat(input.value);

            // Validation du prix
            if (isNaN(prix) || prix < 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Prix invalide',
                    text: 'Veuillez entrer un prix valide'
                });
                return;
            }

            // Token CSRF
            const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

            try {
                const response = await fetch(`/avoir/${avoirId}/update-prix`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify({ prix: prix.toFixed(2) })
                });

                if (!response.ok) {
                    if (response.status === 403) {
                        throw new Error('Accès non autorisé');
                    } else if (response.status === 404) {
                        throw new Error('Prix non trouvé');
                    } else {
                        throw new Error('Erreur serveur');
                    }
                }

                const data = await response.json();
                if (data.success) {
                    document.getElementById(`prix-${avoirId}`).textContent = `${prix.toFixed(2)}€`;
                    toggleEdit(avoirId);
                    Swal.fire({
                        icon: 'success',
                        title: 'Succès',
                        text: 'Prix mis à jour avec succès',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    throw new Error(data.message || 'Erreur lors de la mise à jour du prix');
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: error.message || 'Une erreur est survenue lors de la mise à jour du prix'
                });
                console.error('Erreur:', error);
            }
        }

        /**
         * Applique le filtre par catégorie
         */
        function filtrerParCategorie() {
            const categorieSelect = document.getElementById('categorie-select');
            const categorieId = categorieSelect.value;
            const urlParams = new URLSearchParams(window.location.search);

            if (categorieId) {
                urlParams.set('categorie', categorieId);
            } else {
                urlParams.delete('categorie');
            }

            window.location.href = `${window.location.pathname}?${urlParams.toString()}`;
        }

        /**
         * Applique le tri sélectionné
         */
        function triCategorie() {
            const sortSelect = document.getElementById('sortSelect');
            const sortValue = sortSelect.value;
            const urlParams = new URLSearchParams(window.location.search);

            if (sortValue) {
                urlParams.set('sort', sortValue);
            } else {
                urlParams.delete('sort');
            }

            window.location.href = `${window.location.pathname}?${urlParams.toString()}`;
        }

        // Initialisation des événements au chargement de la page
        document.addEventListener('DOMContentLoaded', function () {
            // Gestion du statut en ligne/hors ligne des produits
            const selects = document.querySelectorAll('.en-ligne-select');
            selects.forEach(select => {
                select.addEventListener('change', async function () {
                    const produitId = this.getAttribute('data-id');
                    const newValue = this.value;
                    const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

                    try {
                        const response = await fetch(`/produit/${produitId}/update-en-ligne`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                                'X-CSRF-TOKEN': token
                            },
                            body: JSON.stringify({ enLigne: newValue })
                        });

                        if (!response.ok) {
                            if (response.status === 403) {
                                throw new Error('Accès non autorisé');
                            } else if (response.status === 404) {
                                throw new Error('Produit non trouvé');
                            } else {
                                throw new Error('Erreur serveur');
                            }
                        }

                        const data = await response.json();
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Succès',
                                text: 'Statut mis à jour avec succès',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        } else {
                            throw new Error(data.message || 'Erreur lors de la mise à jour du statut');
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Erreur',
                            text: error.message || 'Une erreur est survenue lors de la mise à jour du statut'
                        });
                        console.error('Erreur AJAX :', error);
                        // Rétablir l'ancienne valeur en cas d'erreur
                        this.value = this.value === "1" ? "0" : "1";
                    }
                });
            });
        });
    </script>

    {# Inclusion de SweetAlert2 pour les confirmations #}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        /**
         * Affiche une boîte de dialogue de confirmation avant la suppression
         * @param {string} produitId - ID du produit à supprimer
         * @param {string} produitNom - Nom du produit à supprimer
         */
        function confirmDelete(produitId, produitNom) {
            Swal.fire({
                title: "Confirmation",
                text: `Êtes-vous sûr de vouloir supprimer '${produitNom}' ?`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Oui, supprimer",
                cancelButtonText: "Annuler"
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`delete-form-${produitId}`).submit();
                }
            });
        }
    </script>
{% endblock %}